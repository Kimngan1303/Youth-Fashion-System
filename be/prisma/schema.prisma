// Prisma Schema matching exact MySQL DDL for youth_fashion database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Employees
model Employee {
  employee_id   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  employee_code String         @unique @db.VarChar(30)
  full_name     String         @db.VarChar(100)
  email         String         @unique @db.VarChar(255)
  phone         String?        @unique @db.VarChar(20)
  password_hash String         @db.VarChar(255)
  employee_role EmployeeRole   @default(MANAGER)
  status        EmployeeStatus @default(ACTIVE)
  last_login_at DateTime?      @db.DateTime
  created_at    DateTime       @default(now()) @db.DateTime
  updated_at    DateTime       @default(now()) @updatedAt @db.DateTime

  managed_orders             Order[]                  @relation("ManagedOrders")
  conversations              Conversation[]
  sent_messages              Message[]                @relation("EmployeeMessages")
  notifications              Notification[]
  refresh_tokens             RefreshToken[]
  email_verification_tokens  EmailVerificationToken[]
  password_reset_tokens      PasswordResetToken[]

  @@map("employees")
}

enum EmployeeRole {
  ADMIN
  MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// 2. Customers
model Customer {
  customer_id       BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  full_name         String         @db.VarChar(100)
  email             String         @unique @db.VarChar(255)
  phone             String?        @unique @db.VarChar(20)
  password_hash     String         @db.VarChar(255)
  avatar_url        String?        @db.VarChar(500)
  email_verified_at DateTime?      @db.DateTime
  status            CustomerStatus @default(ACTIVE)
  last_login_at     DateTime?      @db.DateTime
  created_at        DateTime       @default(now()) @db.DateTime
  updated_at        DateTime       @default(now()) @updatedAt @db.DateTime

  orders                    Order[]
  conversations             Conversation[]
  sent_messages             Message[]                @relation("CustomerMessages")
  notifications             Notification[]
  cart                      Cart?
  refresh_tokens            RefreshToken[]
  email_verification_tokens EmailVerificationToken[]
  password_reset_tokens     PasswordResetToken[]

  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// 3. Categories
model Category {
  category_id   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  category_name String         @unique @db.VarChar(100)
  description   String?        @db.VarChar(500)
  status        CategoryStatus @default(ACTIVE)
  created_at    DateTime       @default(now()) @db.DateTime
  updated_at    DateTime       @default(now()) @updatedAt @db.DateTime

  products Product[]

  @@map("categories")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

// 4. Brands
model Brand {
  brand_id    BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  brand_name  String      @unique @db.VarChar(100)
  description String?     @db.VarChar(500)
  status      BrandStatus @default(ACTIVE)
  created_at  DateTime    @default(now()) @db.DateTime
  updated_at  DateTime    @default(now()) @updatedAt @db.DateTime

  products Product[]

  @@map("brands")
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

// 5. Products
model Product {
  product_id   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  category_id  BigInt        @db.UnsignedBigInt
  brand_id     BigInt        @db.UnsignedBigInt
  product_name String        @db.VarChar(200)
  description  String?       @db.Text
  status       ProductStatus @default(ACTIVE)
  created_at   DateTime      @default(now()) @db.DateTime
  updated_at   DateTime      @default(now()) @updatedAt @db.DateTime

  category Category         @relation(fields: [category_id], references: [category_id], onUpdate: Cascade, onDelete: Restrict)
  brand    Brand            @relation(fields: [brand_id], references: [brand_id], onUpdate: Cascade, onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

// 6. Product Variants
model ProductVariant {
  variant_id BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt        @db.UnsignedBigInt
  sku        String        @unique @db.VarChar(100)
  size       String        @db.VarChar(30)
  color      String        @db.VarChar(50)
  price      Decimal       @db.Decimal(12, 2)
  stock      Int           @default(0) @db.UnsignedInt
  status     VariantStatus @default(ACTIVE)
  created_at DateTime      @default(now()) @db.DateTime
  updated_at DateTime      @default(now()) @updatedAt @db.DateTime

  product     Product     @relation(fields: [product_id], references: [product_id], onUpdate: Cascade, onDelete: Cascade)
  order_items OrderItem[]
  cart_items  CartItem[]

  @@unique([product_id, size, color], name: "uq_product_variant_combination")
  @@map("product_variants")
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

// 7. Product Images
model ProductImage {
  image_id      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id    BigInt   @db.UnsignedBigInt
  image_url     String   @db.VarChar(500)
  alt_text      String?  @db.VarChar(255)
  display_order Int      @default(0) @db.UnsignedInt
  is_primary    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.DateTime

  product Product @relation(fields: [product_id], references: [product_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("product_images")
}

// 8. Orders
model Order {
  order_id               BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  order_number           String      @unique @db.VarChar(50)
  customer_id            BigInt?     @db.UnsignedBigInt
  managed_by_employee_id BigInt?     @db.UnsignedBigInt
  recipient_name         String      @db.VarChar(100)
  recipient_phone        String      @db.VarChar(20)
  recipient_email        String?     @db.VarChar(255)
  shipping_address_line  String      @db.VarChar(255)
  shipping_ward          String?     @db.VarChar(100)
  shipping_district      String?     @db.VarChar(100)
  shipping_city          String      @db.VarChar(100)
  total_amount           Decimal     @default(0) @db.Decimal(12, 2)
  order_status           OrderStatus @default(PENDING)
  note                   String?     @db.VarChar(500)
  created_at             DateTime    @default(now()) @db.DateTime
  updated_at             DateTime    @default(now()) @updatedAt @db.DateTime

  customer            Customer?   @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: SetNull)
  managed_by_employee Employee?   @relation("ManagedOrders", fields: [managed_by_employee_id], references: [employee_id], onUpdate: Cascade, onDelete: SetNull)
  order_items         OrderItem[]
  payments            Payment[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// 9. Order Items
model OrderItem {
  order_item_id BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  order_id      BigInt   @db.UnsignedBigInt
  variant_id    BigInt   @db.UnsignedBigInt
  product_name  String   @db.VarChar(200)
  sku           String   @db.VarChar(100)
  size          String   @db.VarChar(30)
  color         String   @db.VarChar(50)
  unit_price    Decimal  @db.Decimal(12, 2)
  quantity      Int      @db.UnsignedInt
  subtotal      Decimal  @db.Decimal(12, 2)
  created_at    DateTime @default(now()) @db.DateTime

  order   Order          @relation(fields: [order_id], references: [order_id], onUpdate: Cascade, onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [variant_id], onUpdate: Cascade, onDelete: Restrict)

  @@map("order_items")
}

// 10. Payments
model Payment {
  payment_id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  order_id                BigInt        @db.UnsignedBigInt
  payment_method          PaymentMethod
  payment_status          PaymentStatus @default(PENDING)
  amount                  Decimal       @db.Decimal(12, 2)
  provider_payment_id     String?       @db.VarChar(255)
  provider_transaction_id String?       @db.VarChar(255)
  paid_at                 DateTime?     @db.DateTime
  failure_reason          String?       @db.VarChar(500)
  created_at              DateTime      @default(now()) @db.DateTime
  updated_at              DateTime      @default(now()) @updatedAt @db.DateTime

  order Order @relation(fields: [order_id], references: [order_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("payments")
}

enum PaymentMethod {
  PAYOS
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

// 11. Conversations
model Conversation {
  conversation_id BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id     BigInt             @db.UnsignedBigInt
  employee_id     BigInt             @db.UnsignedBigInt
  status          ConversationStatus @default(OPEN)
  created_at      DateTime           @default(now()) @db.DateTime
  updated_at      DateTime           @default(now()) @updatedAt @db.DateTime

  customer Customer  @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  employee Employee  @relation(fields: [employee_id], references: [employee_id], onUpdate: Cascade, onDelete: Restrict)
  messages Message[]

  @@unique([customer_id, employee_id])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  CLOSED
}

// 12. Messages
model Message {
  message_id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id    BigInt      @db.UnsignedBigInt
  sender_customer_id BigInt?     @db.UnsignedBigInt
  sender_employee_id BigInt?     @db.UnsignedBigInt
  message_type       MessageType @default(TEXT)
  message_content    String?     @db.Text
  attachment_url     String?     @db.VarChar(500)
  is_read            Boolean     @default(false)
  created_at         DateTime    @default(now()) @db.DateTime

  conversation    Conversation @relation(fields: [conversation_id], references: [conversation_id], onUpdate: Cascade, onDelete: Cascade)
  customer_sender Customer?    @relation("CustomerMessages", fields: [sender_customer_id], references: [customer_id], onUpdate: Cascade, onDelete: SetNull)
  employee_sender Employee?    @relation("EmployeeMessages", fields: [sender_employee_id], references: [employee_id], onUpdate: Cascade, onDelete: SetNull)

  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

// 13. Notifications
model Notification {
  notification_id   BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id       BigInt?          @db.UnsignedBigInt
  employee_id       BigInt?          @db.UnsignedBigInt
  notification_type NotificationType
  title             String           @db.VarChar(200)
  message           String           @db.VarChar(500)
  reference_id      BigInt?          @db.UnsignedBigInt
  is_read           Boolean          @default(false)
  created_at        DateTime         @default(now()) @db.DateTime

  customer Customer? @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [employee_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  ORDER
  PAYMENT
  MESSAGE
  SYSTEM
}

// 14. Carts
model Cart {
  cart_id     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id BigInt   @unique @db.UnsignedBigInt
  created_at  DateTime @default(now()) @db.DateTime
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime

  customer   Customer   @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  cart_items CartItem[]

  @@map("carts")
}

// 15. Cart Items
model CartItem {
  cart_id    BigInt   @db.UnsignedBigInt
  variant_id BigInt   @db.UnsignedBigInt
  quantity   Int      @default(1) @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime
  updated_at DateTime @default(now()) @updatedAt @db.DateTime

  cart    Cart           @relation(fields: [cart_id], references: [cart_id], onUpdate: Cascade, onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [variant_id], onUpdate: Cascade, onDelete: Restrict)

  @@id([cart_id, variant_id])
  @@map("cart_items")
}

// 16. Refresh Tokens
model RefreshToken {
  refresh_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id      BigInt?   @db.UnsignedBigInt
  employee_id      BigInt?   @db.UnsignedBigInt
  token_hash       String    @unique @db.VarChar(255)
  expires_at       DateTime  @db.DateTime
  revoked_at       DateTime? @db.DateTime
  created_at       DateTime  @default(now()) @db.DateTime

  customer Customer? @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [employee_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("refresh_tokens")
}

// 17. Email Verification Tokens
model EmailVerificationToken {
  email_verification_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id                 BigInt?   @db.UnsignedBigInt
  employee_id                 BigInt?   @db.UnsignedBigInt
  token_hash                  String    @unique @db.VarChar(255)
  expires_at                  DateTime  @db.DateTime
  verified_at                 DateTime? @db.DateTime
  created_at                  DateTime  @default(now()) @db.DateTime

  customer Customer? @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [employee_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("email_verification_tokens")
}

// 18. Password Reset Tokens
model PasswordResetToken {
  password_reset_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id             BigInt?   @db.UnsignedBigInt
  employee_id             BigInt?   @db.UnsignedBigInt
  token_hash              String    @unique @db.VarChar(255)
  expires_at              DateTime  @db.DateTime
  used_at                 DateTime? @db.DateTime
  created_at              DateTime  @default(now()) @db.DateTime

  customer Customer? @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [employee_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("password_reset_tokens")
}

// 19. AI Search Configs
model AiSearchConfig {
  ai_search_config_id BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  config_name         String   @unique @db.VarChar(100)
  model_name          String   @db.VarChar(255)
  model_provider      String   @db.VarChar(100)
  qdrant_url          String   @db.VarChar(500)
  qdrant_collection   String   @db.VarChar(255)
  embedding_dimension Int      @db.UnsignedInt
  image_weight        Decimal  @default(0.7000) @db.Decimal(5, 4)
  text_weight         Decimal  @default(0.3000) @db.Decimal(5, 4)
  top_k               Int      @default(20) @db.UnsignedInt
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.DateTime
  updated_at          DateTime @default(now()) @updatedAt @db.DateTime

  @@map("ai_search_configs")
}
