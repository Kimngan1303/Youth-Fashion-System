generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Employee {
  employee_id               BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  employee_code             String                   @unique @db.VarChar(30)
  full_name                 String                   @db.VarChar(100)
  email                     String                   @unique @db.VarChar(255)
  phone                     String?                  @unique @db.VarChar(20)
  password_hash             String                   @db.VarChar(255)
  employee_role             EmployeeRole             @default(MANAGER)
  status                    EmployeeStatus           @default(ACTIVE)
  last_login_at             DateTime?                @db.DateTime(0)
  created_at                DateTime                 @default(now()) @db.DateTime(0)
  updated_at                DateTime                 @default(now()) @updatedAt @db.DateTime(0)
  conversations             Conversation[]
  email_verification_tokens EmailVerificationToken[]
  sent_messages             Message[]                @relation("EmployeeMessages")
  notifications             Notification[]
  managed_orders            Order[]                  @relation("ManagedOrders")
  password_reset_tokens     PasswordResetToken[]
  refresh_tokens            RefreshToken[]

  @@map("employees")
}

model Customer {
  customer_id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  full_name                 String         @db.VarChar(100)
  email                     String         @unique @db.VarChar(255)
  phone                     String?        @unique @db.VarChar(20)
  password_hash             String         @db.VarChar(255)
  avatar_url                String?        @db.VarChar(500)
  email_verified_at         DateTime?      @db.DateTime(0)
  status                    CustomerStatus @default(ACTIVE)
  last_login_at             DateTime?      @db.DateTime(0)
  created_at                DateTime       @default(now()) @db.DateTime(0)
  updated_at                DateTime       @default(now()) @updatedAt @db.DateTime(0)
  cart                      Cart?
  conversations             Conversation[]
  email_verification_tokens EmailVerificationToken[]
  sent_messages             Message[]                @relation("CustomerMessages")
  notifications             Notification[]
  orders                    Order[]
  password_reset_tokens     PasswordResetToken[]
  refresh_tokens            RefreshToken[]
  search_histories          UserSearchHistory[]

  @@map("customers")
}


model Category {
  category_id   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  category_name String         @unique @db.VarChar(100)
  description   String?        @db.VarChar(500)
  status        CategoryStatus @default(ACTIVE)
  created_at    DateTime       @default(now()) @db.DateTime(0)
  updated_at    DateTime       @default(now()) @updatedAt @db.DateTime(0)
  products      Product[]

  @@map("categories")
}

model Brand {
  brand_id    BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  brand_name  String      @unique @db.VarChar(100)
  description String?     @db.VarChar(500)
  status      BrandStatus @default(ACTIVE)
  created_at  DateTime    @default(now()) @db.DateTime(0)
  updated_at  DateTime    @default(now()) @updatedAt @db.DateTime(0)
  products    Product[]

  @@map("brands")
}

model Product {
  product_id   BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  category_id  BigInt           @db.UnsignedBigInt
  brand_id     BigInt           @db.UnsignedBigInt
  product_name String           @db.VarChar(200)
  description  String?          @db.Text
  status       ProductStatus    @default(ACTIVE)
  created_at   DateTime         @default(now()) @db.DateTime(0)
  updated_at   DateTime         @default(now()) @updatedAt @db.DateTime(0)
  images       ProductImage[]
  variants     ProductVariant[]
  embeddings   ProductEmbedding[]
  brand        Brand            @relation(fields: [brand_id], references: [brand_id])
  category     Category         @relation(fields: [category_id], references: [category_id])

  @@index([brand_id], map: "products_brand_id_fkey")
  @@index([category_id], map: "products_category_id_fkey")
  @@map("products")
}

model ProductVariant {
  variant_id  BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  product_id  BigInt        @db.UnsignedBigInt
  sku         String        @unique @db.VarChar(100)
  size        String        @db.VarChar(30)
  color       String        @db.VarChar(50)
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0) @db.UnsignedInt
  status      VariantStatus @default(ACTIVE)
  created_at  DateTime      @default(now()) @db.DateTime(0)
  updated_at  DateTime      @default(now()) @updatedAt @db.DateTime(0)
  cart_items  CartItem[]
  order_items OrderItem[]
  product     Product       @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([product_id, size, color], name: "uq_product_variant_combination")
  @@map("product_variants")
}

model ProductImage {
  image_id      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id    BigInt   @db.UnsignedBigInt
  image_url     String   @db.VarChar(500)
  alt_text      String?  @db.VarChar(255)
  display_order Int      @default(0) @db.UnsignedInt
  is_primary    Boolean            @default(false)
  created_at    DateTime           @default(now()) @db.DateTime(0)
  embeddings    ProductEmbedding[]
  product       Product            @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@index([product_id], map: "product_images_product_id_fkey")
  @@map("product_images")
}

model Order {
  order_id               BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  order_number           String      @unique @db.VarChar(50)
  customer_id            BigInt?     @db.UnsignedBigInt
  managed_by_employee_id BigInt?     @db.UnsignedBigInt
  recipient_name         String      @db.VarChar(100)
  recipient_phone        String      @db.VarChar(20)
  recipient_email        String?     @db.VarChar(255)
  shipping_address_line  String      @db.VarChar(255)
  shipping_ward          String?     @db.VarChar(100)
  shipping_district      String?     @db.VarChar(100)
  shipping_city          String      @db.VarChar(100)
  total_amount           Decimal     @default(0.00) @db.Decimal(12, 2)
  order_status           OrderStatus @default(PENDING)
  note                   String?     @db.VarChar(500)
  created_at             DateTime    @default(now()) @db.DateTime(0)
  updated_at             DateTime    @default(now()) @updatedAt @db.DateTime(0)
  order_items            OrderItem[]
  customer               Customer?   @relation(fields: [customer_id], references: [customer_id])
  managed_by_employee    Employee?   @relation("ManagedOrders", fields: [managed_by_employee_id], references: [employee_id])
  payments               Payment[]

  @@index([customer_id], map: "orders_customer_id_fkey")
  @@index([managed_by_employee_id], map: "orders_managed_by_employee_id_fkey")
  @@map("orders")
}

model OrderItem {
  order_item_id BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  order_id      BigInt         @db.UnsignedBigInt
  variant_id    BigInt         @db.UnsignedBigInt
  product_name  String         @db.VarChar(200)
  sku           String         @db.VarChar(100)
  size          String         @db.VarChar(30)
  color         String         @db.VarChar(50)
  unit_price    Decimal        @db.Decimal(12, 2)
  quantity      Int            @db.UnsignedInt
  subtotal      Decimal        @db.Decimal(12, 2)
  created_at    DateTime       @default(now()) @db.DateTime(0)
  order         Order          @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variant_id], references: [variant_id])

  @@index([order_id], map: "order_items_order_id_fkey")
  @@index([variant_id], map: "order_items_variant_id_fkey")
  @@map("order_items")
}

model Payment {
  payment_id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  order_id                BigInt        @db.UnsignedBigInt
  payment_method          PaymentMethod
  payment_status          PaymentStatus @default(PENDING)
  amount                  Decimal       @db.Decimal(12, 2)
  provider_payment_id     String?       @db.VarChar(255)
  provider_transaction_id String?       @db.VarChar(255)
  paid_at                 DateTime?     @db.DateTime(0)
  failure_reason          String?       @db.VarChar(500)
  created_at              DateTime      @default(now()) @db.DateTime(0)
  updated_at              DateTime      @default(now()) @updatedAt @db.DateTime(0)
  order                   Order         @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id], map: "payments_order_id_fkey")
  @@map("payments")
}

model Conversation {
  conversation_id BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id     BigInt             @db.UnsignedBigInt
  employee_id     BigInt             @db.UnsignedBigInt
  status          ConversationStatus @default(OPEN)
  created_at      DateTime           @default(now()) @db.DateTime(0)
  updated_at      DateTime           @default(now()) @updatedAt @db.DateTime(0)
  customer        Customer           @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  employee        Employee           @relation(fields: [employee_id], references: [employee_id])
  messages        Message[]

  @@unique([customer_id, employee_id])
  @@index([employee_id], map: "conversations_employee_id_fkey")
  @@map("conversations")
}

model Message {
  message_id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id    BigInt       @db.UnsignedBigInt
  sender_customer_id BigInt?      @db.UnsignedBigInt
  sender_employee_id BigInt?      @db.UnsignedBigInt
  message_type       MessageType  @default(TEXT)
  message_content    String?      @db.Text
  attachment_url     String?      @db.VarChar(500)
  is_read            Boolean      @default(false)
  created_at         DateTime     @default(now()) @db.DateTime(0)
  conversation       Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  customer_sender    Customer?    @relation("CustomerMessages", fields: [sender_customer_id], references: [customer_id])
  employee_sender    Employee?    @relation("EmployeeMessages", fields: [sender_employee_id], references: [employee_id])

  @@index([conversation_id], map: "messages_conversation_id_fkey")
  @@index([sender_customer_id], map: "messages_sender_customer_id_fkey")
  @@index([sender_employee_id], map: "messages_sender_employee_id_fkey")
  @@map("messages")
}

model Notification {
  notification_id   BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id       BigInt?          @db.UnsignedBigInt
  employee_id       BigInt?          @db.UnsignedBigInt
  notification_type NotificationType
  title             String           @db.VarChar(200)
  message           String           @db.VarChar(500)
  reference_id      BigInt?          @db.UnsignedBigInt
  is_read           Boolean          @default(false)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  customer          Customer?        @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  employee          Employee?        @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)

  @@index([customer_id], map: "notifications_customer_id_fkey")
  @@index([employee_id], map: "notifications_employee_id_fkey")
  @@map("notifications")
}

model Cart {
  cart_id     BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id BigInt     @unique @db.UnsignedBigInt
  created_at  DateTime   @default(now()) @db.DateTime(0)
  updated_at  DateTime   @default(now()) @updatedAt @db.DateTime(0)
  cart_items  CartItem[]
  customer    Customer   @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  cart_id    BigInt         @db.UnsignedBigInt
  variant_id BigInt         @db.UnsignedBigInt
  quantity   Int            @default(1) @db.UnsignedInt
  created_at DateTime       @default(now()) @db.DateTime(0)
  updated_at DateTime       @default(now()) @updatedAt @db.DateTime(0)
  cart       Cart           @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variant_id], references: [variant_id])

  @@id([cart_id, variant_id])
  @@index([variant_id], map: "cart_items_variant_id_fkey")
  @@map("cart_items")
}

model RefreshToken {
  refresh_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id      BigInt?   @db.UnsignedBigInt
  employee_id      BigInt?   @db.UnsignedBigInt
  token_hash       String    @unique @db.VarChar(255)
  expires_at       DateTime  @db.DateTime(0)
  revoked_at       DateTime? @db.DateTime(0)
  created_at       DateTime  @default(now()) @db.DateTime(0)
  customer         Customer? @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  employee         Employee? @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)

  @@index([customer_id], map: "refresh_tokens_customer_id_fkey")
  @@index([employee_id], map: "refresh_tokens_employee_id_fkey")
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  email_verification_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id                 BigInt?   @db.UnsignedBigInt
  employee_id                 BigInt?   @db.UnsignedBigInt
  token_hash                  String    @unique @db.VarChar(255)
  expires_at                  DateTime  @db.DateTime(0)
  verified_at                 DateTime? @db.DateTime(0)
  created_at                  DateTime  @default(now()) @db.DateTime(0)
  attempts                    Int       @default(0) @db.UnsignedInt
  customer                    Customer? @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  employee                    Employee? @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)

  @@index([customer_id], map: "email_verification_tokens_customer_id_fkey")
  @@index([employee_id], map: "email_verification_tokens_employee_id_fkey")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  password_reset_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id             BigInt?   @db.UnsignedBigInt
  employee_id             BigInt?   @db.UnsignedBigInt
  token_hash              String    @unique @db.VarChar(255)
  expires_at              DateTime  @db.DateTime(0)
  used_at                 DateTime? @db.DateTime(0)
  created_at              DateTime  @default(now()) @db.DateTime(0)
  customer                Customer? @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  employee                Employee? @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)

  @@index([customer_id], map: "password_reset_tokens_customer_id_fkey")
  @@index([employee_id], map: "password_reset_tokens_employee_id_fkey")
  @@map("password_reset_tokens")
}

model AiSearchConfig {
  ai_search_config_id BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  config_name         String   @unique @db.VarChar(100)
  model_name          String   @db.VarChar(255)
  model_provider      String   @db.VarChar(100)
  qdrant_url          String   @db.VarChar(500)
  qdrant_collection   String   @db.VarChar(255)
  embedding_dimension Int      @db.UnsignedInt
  image_weight        Decimal  @default(0.7000) @db.Decimal(5, 4)
  text_weight         Decimal  @default(0.3000) @db.Decimal(5, 4)
  top_k               Int      @default(20) @db.UnsignedInt
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now()) @db.DateTime(0)
  updated_at          DateTime           @default(now()) @updatedAt @db.DateTime(0)
  embeddings          ProductEmbedding[]

  @@map("ai_search_configs")
}

model ProductEmbedding {
  embedding_id        BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  product_id          BigInt         @db.UnsignedBigInt
  image_id            BigInt?        @db.UnsignedBigInt
  ai_search_config_id BigInt         @db.UnsignedBigInt
  qdrant_point_id     String         @db.VarChar(100)
  embedding_type      EmbeddingType  @default(IMAGE)
  status              SyncStatus     @default(PENDING)
  last_synced_at      DateTime?      @db.DateTime(0)
  created_at          DateTime       @default(now()) @db.DateTime(0)
  updated_at          DateTime       @default(now()) @updatedAt @db.DateTime(0)
  ai_config           AiSearchConfig @relation(fields: [ai_search_config_id], references: [ai_search_config_id])
  image               ProductImage?  @relation(fields: [image_id], references: [image_id], onDelete: Cascade)
  product             Product        @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@index([product_id], map: "product_embeddings_product_id_fkey")
  @@index([image_id], map: "product_embeddings_image_id_fkey")
  @@index([ai_search_config_id], map: "product_embeddings_ai_search_config_id_fkey")
  @@index([status], map: "product_embeddings_status_idx")
  @@map("product_embeddings")
}

model UserSearchHistory {
  search_id        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id      BigInt?    @db.UnsignedBigInt
  search_type      SearchType @default(TEXT)
  query_text       String?    @db.VarChar(255)
  search_image_url String?    @db.VarChar(500)
  filters_applied  String?    @db.Text
  results_count    Int        @default(0) @db.UnsignedInt
  created_at       DateTime   @default(now()) @db.DateTime(0)
  customer         Customer?  @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@index([customer_id], map: "user_search_histories_customer_id_fkey")
  @@index([query_text], map: "user_search_histories_query_text_idx")
  @@map("user_search_histories")
}

enum EmployeeRole {
  ADMIN
  MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PAYOS
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

enum NotificationType {
  ORDER
  PAYMENT
  MESSAGE
  SYSTEM
}

enum EmbeddingType {
  IMAGE
  TEXT
  HYBRID
}

enum SyncStatus {
  PENDING
  INDEXED
  FAILED
}

enum SearchType {
  TEXT
  IMAGE
  HYBRID
}

// 17. Email Verification Tokens
model EmailVerificationToken {
  email_verification_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id                 BigInt?   @db.UnsignedBigInt
  employee_id                 BigInt?   @db.UnsignedBigInt
  token_hash                  String    @unique @db.VarChar(255)
  expires_at                  DateTime  @db.DateTime(0)
  verified_at                 DateTime? @db.DateTime(0)
  created_at                  DateTime  @default(now()) @db.DateTime(0)

  customer Customer? @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [employee_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("email_verification_tokens")
}

// 18. Password Reset Tokens
model PasswordResetToken {
  password_reset_token_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id             BigInt?   @db.UnsignedBigInt
  employee_id             BigInt?   @db.UnsignedBigInt
  token_hash              String    @unique @db.VarChar(255)
  expires_at              DateTime  @db.DateTime(0)
  used_at                 DateTime? @db.DateTime(0)
  created_at              DateTime  @default(now()) @db.DateTime(0)

  customer Customer? @relation(fields: [customer_id], references: [customer_id], onUpdate: Cascade, onDelete: Cascade)
  employee Employee? @relation(fields: [employee_id], references: [employee_id], onUpdate: Cascade, onDelete: Cascade)

  @@map("password_reset_tokens")
}

// 19. AI Search Configs
model AiSearchConfig {
  ai_search_config_id BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  config_name         String   @unique @db.VarChar(100)
  model_name          String   @db.VarChar(255)
  model_provider      String   @db.VarChar(100)
  qdrant_url          String   @db.VarChar(500)
  qdrant_collection   String   @db.VarChar(255)
  embedding_dimension Int      @db.UnsignedInt
  image_weight        Decimal  @default(0.7000) @db.Decimal(5, 4)
  text_weight         Decimal  @default(0.3000) @db.Decimal(5, 4)
  top_k               Int      @default(20) @db.UnsignedInt
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.DateTime(0)
  updated_at          DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@map("ai_search_configs")
}
